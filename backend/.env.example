# Dukan Sathi Backend - Environment Variables Template
# Purpose: Template for environment configuration
# Instructions: Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=https://xfnoquphbeaqslownzxw.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Groq API (Free Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# Google Vertex AI (for Gemini 2.0 Flash)
# Path to your Google Cloud service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Optional: Tuned Gemini Model ID (if you have custom trained model)
# TUNED_MODEL_ID=projects/YOUR_PROJECT/locations/us-central1/models/YOUR_MODEL_ID

# CORS Configuration  
# Frontend URL for CORS (development)
FRONTEND_URL=http://localhost:5173

# Server Configuration
PORT=8000

# Telegram Bot (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Logging Level
LOG_LEVEL=INFO
