# =============================================================
# Dukan Sathi Backend — Environment Variables Template
# =============================================================
# Instructions: Copy this file to .env and fill in real values.
#   cp backend/.env.example backend/.env
# NEVER commit the real .env file.

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Google Vertex AI / Gemini ─────────────────────────────────
# Path to your Google Cloud service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# Optional: Tuned Gemini Model ID
# TUNED_MODEL_ID=projects/YOUR_PROJECT/locations/us-central1/models/YOUR_MODEL_ID

# ── Groq API (Whisper STT Fallback) ──────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Sarvam AI (Hindi TTS) ────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# ── Razorpay Subscription Billing ────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── JWT (for usage tokens) ────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string

# ── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=YourBotUsername
# Cloud Run webhook URL (leave blank for local polling mode)
WEBHOOK_URL=https://your-cloudrun-service.run.app
# HMAC secret for Telegram webhook verification
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here

# ── CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CLOUD_RUN_URL=

# ── Server ────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
ENV=development

# ── Feature Flags ─────────────────────────────────────────────
ENABLE_OFFLINE_STT=true
