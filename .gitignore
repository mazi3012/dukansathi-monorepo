backend/service_account.json
*-credentials.json
credentials.json
google-credentials.json
*.pem
*.key
*.p12
*.pfx

# ── Logs ──────────────────────────────────
*.log
logs/
backend.log
backend/backend.log
backend/telegram_bot.log
telegram_bot.log

# ── Local Databases ───────────────────────
*.db
*.sqlite
*.sqlite3
backend/dukansathi_offline.db

# ── Node.js ───────────────────────────────
node_modules/
*/node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
.vite/

# ── Python ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# ── Virtual Environments ──────────────────
venv/
env/
ENV/
*/venv/
*/env/
virtualenv/

# ── IDE / OS ──────────────────────────────
.vscode/
.idea/
.DS_Store
.DS_Storeg
Thumbs.db
*.swp
*.swo
*~
Desktop.ini

# ── Docker / Deploy meta ──────────────────
